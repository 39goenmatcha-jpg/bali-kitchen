rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isOwner() { return isAuth() && role() == 'owner'; }
    function isStaff() { return isAuth() && (role() == 'staff' || role() == 'owner'); }

    // 在庫: owner=読み書き、staff=読み取りのみ
    match /inventory/{productId} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    // 注文: owner=読み書き、staff=読み書き（status/labelUrl更新を含む）
    match /orders/{orderId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isStaff();
      allow delete: if isOwner();
    }

    // ユーザー: owner=全読み書き、staff=自分のドキュメントのみ更新
    match /users/{uid} {
      allow read: if isOwner() || request.auth.uid == uid;
      allow create: if isOwner();
      allow update: if isOwner() ||
        (request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['fcmToken', 'language']));
      allow delete: if isOwner();
    }

    // 通知: owner=読み書き、staff=acknowledged更新のみ
    match /notifications/{notifId} {
      allow read: if isStaff();
      allow create, delete: if isOwner();
      allow update: if isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['acknowledged']);
    }
  }
}
